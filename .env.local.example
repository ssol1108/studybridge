# Anthropic Claude API 키 (없으면 각 API route가 mock 데이터로 대체 응답함)
ANTHROPIC_API_KEY=

# Semantic Scholar API 키 (선택) — 없어도 검색은 되지만 IP당 rate limit이 매우 낮아
# 공유 네트워크(사무실 와이파이, 클라우드 IP 등)에서는 429(Too Many Requests)가 자주 남.
# https://www.semanticscholar.org/product/api#api-key-form 에서 무료로 신청 가능.
SEMANTIC_SCHOLAR_API_KEY=
